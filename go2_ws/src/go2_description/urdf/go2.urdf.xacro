<?xml version="1.0"?>
<robot name="go2" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Go2 Pro body dimensions -->
  <xacro:property name="body_l" value="0.62"/>
  <xacro:property name="body_w" value="0.28"/>
  <xacro:property name="body_h" value="0.114"/>
  <!-- Standing height: center of body above ground -->
  <xacro:property name="body_z" value="0.28"/>
  <!-- Leg geometry -->
  <xacro:property name="leg_w" value="0.04"/>
  <xacro:property name="leg_h" value="0.223"/>  <!-- body_z - body_h/2 -->
  <!-- Diff-drive wheels (virtual, hidden under body) -->
  <xacro:property name="wheel_r" value="0.04"/>
  <xacro:property name="wheel_t" value="0.02"/>
  <!-- LiDAR (Livox Mid360 simplified as 2D scanner) -->
  <xacro:property name="laser_h" value="0.05"/>
  <xacro:property name="M_PI" value="3.14159265359"/>

  <material name="go2_yellow"><color rgba="0.85 0.70 0.05 1.0"/></material>
  <material name="go2_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="go2_grey"><color rgba="0.45 0.45 0.45 1.0"/></material>
  <material name="go2_dark"><color rgba="0.20 0.20 0.20 1.0"/></material>

  <!-- ==================== base_footprint ==================== -->
  <link name="base_footprint">
    <visual>
      <geometry><box size="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <!-- ==================== body ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="go2_yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.168" ixy="0" ixz="0" iyy="0.422" iyz="0" izz="0.517"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== legs (4×, visual + collision only) ==================== -->
  <xacro:macro name="leg" params="name px py">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 ${-leg_h/2}" rpy="0 0 0"/>
        <geometry><box size="${leg_w} ${leg_w} ${leg_h}"/></geometry>
        <material name="go2_black"/>
      </visual>
      <!-- No collision on legs — they are visual only; wheels provide ground contact -->
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${px} ${py} ${-body_h/2}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:leg name="fl_leg" px=" 0.155" py=" 0.14"/>
  <xacro:leg name="fr_leg" px=" 0.155" py="-0.14"/>
  <xacro:leg name="rl_leg" px="-0.155" py=" 0.14"/>
  <xacro:leg name="rr_leg" px="-0.155" py="-0.14"/>

  <!-- ==================== diff-drive wheels (virtual) ==================== -->
  <xacro:macro name="wheel" params="name side">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_t}"/></geometry>
        <material name="go2_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_t}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0005"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <!-- wheels at y = ±(body_w/2 + wheel_t/2 + gap), z flush with ground -->
      <origin xyz="0 ${side * (body_w/2 + wheel_t/2 + 0.005)} ${-(body_z - wheel_r)}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left_wheel"  side=" 1"/>
  <xacro:wheel name="right_wheel" side="-1"/>

  <!-- ==================== LiDAR frame ==================== -->
  <!-- No collision on laser_frame: the sensor housing is virtual; collision causes
       Gazebo's ray sensor to detect its own mount geometry at ~0.5 m ahead. -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.042" length="${laser_h}"/></geometry>
      <material name="go2_grey"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <!-- raised to 0.15m above base_link (0.43m above ground) — avoids self-scans at any tilt -->
    <origin xyz="0.08 0 0.15" rpy="0 0 0"/>
  </joint>


  <!-- ==================== Gazebo: body color ==================== -->
  <gazebo reference="base_link">
    <material>Gazebo/Yellow</material>
    <laser_retro>0</laser_retro>
  </gazebo>
  <gazebo reference="fl_leg_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="fr_leg_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rl_leg_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rr_leg_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="laser_frame"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="left_wheel_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="right_wheel_link"><material>Gazebo/DarkGrey</material></gazebo>

  <!-- ==================== Gazebo: differential drive ==================== -->
  <gazebo>
    <plugin name="go2_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace></namespace></ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <!-- wheel_separation = 2 × (body_w/2 + wheel_t/2 + gap) = 2 × (0.14+0.01+0.005) = 0.31 -->
      <wheel_separation>0.31</wheel_separation>
      <wheel_diameter>${2 * wheel_r}</wheel_diameter>
      <max_wheel_torque>80</max_wheel_torque>
      <max_wheel_acceleration>4.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <!-- robot_base_frame must match Nav2 base_frame_id -->
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ==================== Gazebo: 2-D LiDAR (Livox Mid360 simplified) ==================== -->
  <gazebo reference="laser_frame">
    <sensor type="ray" name="livox_mid360_sim">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle> 3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.30</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== Gazebo: IMU ==================== -->
  <gazebo reference="base_link">
    <sensor name="go2_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="go2_imu_plugin">
        <ros><remapping>~/out:=imu</remapping></ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

</robot>
